// Grafana Alloy Configuration for Auth Microservice

// Discover containers running on Docker
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Extract container name as a label
discovery.relabel "docker_logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  // Label logs specifically from auth-service
  rule {
    source_labels = ["container"]
    regex         = "(.*auth.*)"
    target_label  = "service"
    replacement   = "auth-service"
  }
}

// Scrape stdout/stderr from containers
loki.source.docker "docker_scraper" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_logs.output
  forward_to = [loki.process.parse_json.receiver]
}

// Parse structured Pino logs and extract ONLY the string fields used as labels.
// Extracting numeric fields (status, duration) or free-text fields (msg, url)
// causes Alloy to produce malformed JSON in the Loki push request body,
// because numeric values get embedded without proper quoting.
loki.process "parse_json" {
  // Only extract fields that are used as labels — all must be strings.
  stage.json {
    expressions = {
      level   = "level",
      service = "service",
      env     = "env",
    }
  }

  stage.labels {
    values = {
      level   = "level",
      service = "service",
      env     = "env",
    }
  }

  // Ensure a service label is always present even if the log line doesn't include one
  stage.static_labels {
    values = {
      job = "auth-service",
    }
  }

  forward_to = [loki.write.local_loki.receiver]
}

// Forward logs to the local Loki instance (running alongside in Docker Compose)
loki.write "local_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
