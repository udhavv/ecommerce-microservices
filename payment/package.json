    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "glob": "^14.0.2",
    "helmet": "^8.0.0",
    "ip-address": "^10.7.4",
    "jsonwebtoken": "^9.0.3",
    "minimatch": "^11.0.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "postcss-selector-parser": "^7.1.6",
    "undici": "^6.29.1",
    "uuid": "^11.0.5",
    "zod": "^4.6.6"
