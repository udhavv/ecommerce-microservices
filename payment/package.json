{
  "name": "payment-service",
  "version": "1.0.0",
  "description": "Production-grade Mock Payment microservice with transactional outbox, ledger audit trail, and RabbitMQ event streaming",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
