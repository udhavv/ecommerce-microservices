{
  "name": "review-section-service",
  "version": "1.0.0",
  "description": "Production-grade Review, Rating, and Q&A Microservice",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "db:init": "node database/init.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js src/__tests__/unit --runInBand",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js src/__tests__/integration --runInBand"
  },
  "keywords": [
    "microservices",
    "ecommerce",
    "reviews",
    "ratings",
    "qa",
    "express",
    "postgresql"
  ],
  "dependencies": {
    "brace-expansion": "^5.0.12",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "glob": "^14.0.2",
    "helmet": "^8.0.0",
    "ip-address": "^10.7.4",
    "jsonwebtoken": "^9.0.3",
    "minimatch": "^11.0.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "postcss-selector-parser": "^7.1.6",
    "undici": "^6.29.1",
    "uuid": "^11.0.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.9",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/src/__tests__/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/src/__tests__/helpers/"
    ]
  }
}
